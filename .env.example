# --- Required on first run (empty database) -------------------------------------------
# The only built-in account is this administrator. There are no demo users or passwords.
ADMIN_EMAIL="admin@your-company.com"
ADMIN_PASSWORD="change-me-10chars+digits1"   # >= 10 chars, letters + digits
# ADMIN_NAME="시스템 관리자"

# --- Server -----------------------------------------------------------------------------
# PORT=3000
# DATA_DIR=./data                 # where database.json lives (keep it OUT of git, back it up)
# TRUST_PROXY=true                # set when behind a reverse proxy / load balancer (correct client IP for rate limits)
APP_URL="https://schedule.your-company.com"   # used in invitation / password-reset links

# --- Outbound mail (required for invitations and password reset in production) ----------
# SMTP_HOST=smtp.your-company.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="ScheduleSync <no-reply@your-company.com>"
