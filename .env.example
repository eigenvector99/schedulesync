# --- Required on first run (empty database) -------------------------------------------
# The only built-in account is this administrator. There are no demo users or passwords.
ADMIN_EMAIL="admin@your-company.com"
ADMIN_PASSWORD="change-me-10chars+digits1"   # >= 10 chars, letters + digits
# ADMIN_NAME="시스템 관리자"

# --- Database ---------------------------------------------------------------------------
# PostgreSQL connection string (managed PostgreSQL such as Render/Railway/Neon/Supabase/RDS).
# Without it an embedded PostgreSQL stored under DATA_DIR is used: great for development and a small
# single-instance deployment, but it needs a persistent disk and cannot be shared by several instances.
# DATABASE_URL=postgres://user:password@host:5432/schedulesync
# DATABASE_SSL=true                # most managed providers require TLS
# DATABASE_POOL_MAX=10

# --- Server -----------------------------------------------------------------------------
# PORT=3000
# DATA_DIR=./data                 # embedded database location when DATABASE_URL is not set (keep it OUT of git, back it up)
# TRUST_PROXY=true                # set when behind a reverse proxy / load balancer (correct client IP for rate limits)
APP_URL="https://schedule.your-company.com"   # used in invitation / password-reset links

# --- Notifications: Slack DM (recommended) ----------------------------------------------
# Invitations, password-reset links and workflow notifications (assignment requests, approvals, ...)
# are sent as Slack DMs. People are matched by their company e-mail address, so it must be the
# same address their Slack account uses.
# Slack app (https://api.slack.com/apps) -> OAuth & Permissions -> Bot Token Scopes:
#   chat:write, users:read.email    (then "Install to Workspace" and copy the Bot User OAuth Token)
# Keep this token on the server only; never put it in frontend code or commit it.
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_NOTIFY_EVENTS=true        # set false to send only invitations / password resets

# --- Fallback: outbound mail (optional; used when Slack is not configured or a DM fails) -----
# SMTP_HOST=smtp.your-company.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="ScheduleSync <no-reply@your-company.com>"
